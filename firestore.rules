rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function roomParticipant(collectionName, roomId) {
      return signedIn() && get(/databases/$(database)/documents/$(collectionName)/$(roomId)).data.participants is list && request.auth.uid in get(/databases/$(database)/documents/$(collectionName)/$(roomId)).data.participants;
    }

    match /system/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if owns(userId);
    }

    match /chat_rooms/{roomId} {
      allow read, update, delete: if roomParticipant('chat_rooms', roomId);
      allow create: if signedIn() && request.resource.data.participants is list && request.auth.uid in request.resource.data.participants;
      match /messages/{messageId} {
        allow read, update, delete: if roomParticipant('chat_rooms', roomId);
        allow create: if roomParticipant('chat_rooms', roomId) && request.resource.data.senderId == request.auth.uid;
      }
    }

    match /chats/{roomId} {
      allow read, update, delete: if roomParticipant('chats', roomId);
      allow create: if signedIn() && request.resource.data.participants is list && request.auth.uid in request.resource.data.participants;
      match /messages/{messageId} {
        allow read, update, delete: if roomParticipant('chats', roomId);
        allow create: if roomParticipant('chats', roomId) && request.resource.data.senderId == request.auth.uid;
      }
    }

    // These legacy documents currently use app-level IDs rather than Firebase UIDs.
    // Authentication is still required; migrate the document IDs to Firebase UIDs before allowing per-user access.
    match /user_inbox/{userId} {
      allow read, write: if signedIn();
    }

    match /waiting_users/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn();
    }

    match /call_rooms/{roomId} {
      allow read, update, delete: if roomParticipant('call_rooms', roomId);
      allow create: if signedIn() && request.resource.data.participants is list && request.auth.uid in request.resource.data.participants;
    }
  }
}
